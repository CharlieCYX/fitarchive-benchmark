# FitArchive Benchmark — environment variable NAMES ONLY.
# Copy to .env.local and fill in values locally. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider adapter (server-only) ---
# Allowed values: mock | kimi | openai | anthropic | local
# Default: mock (the app must fully work with the mock provider).
AI_PROVIDER=mock
AI_API_KEY=
